# Copy this file to .env (for local dev) and fill in your own keys.
# On Vercel, add these same variables under Project Settings → Environment Variables.
# FIX v2: ANTHROPIC_API_KEY ya no se usa. El backend usa Groq primero (rápido)
# y Gemini como fallback. Pon al menos GROQ_API_KEY.

GROQ_API_KEY=gsk_...
# Opcional pero recomendado como fallback:
GEMINI_API_KEY=...
# Modelo Groq (opcional — por defecto llama-3.1-8b-instant, el más rápido):
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-2.0-flash

UNSPLASH_ACCESS_KEY=...
VOICERSS_API_KEY=...

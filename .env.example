# Copy this file to .env (for local dev) and fill in your own keys.
# On Vercel, add these same variables under Project Settings → Environment Variables.
# ANTHROPIC_API_KEY ya no se usa. El backend usa Groq primero (rápido) y
# Gemini como fallback. Pon al menos GROQ_API_KEY.

GROQ_API_KEY=gsk_...
# Opcional pero recomendado como fallback:
GEMINI_API_KEY=...
# Modelos Groq (ago-2026). Los viejos llama-3.1-8b-instant y
# llama-3.3-70b-versatile fueron RETIRADOS por Groq — NO los uses.
# Recomendado (rápido y barato): openai/gpt-oss-20b.
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.6-flash

UNSPLASH_ACCESS_KEY=...
VOICERSS_API_KEY=...

# ── Supabase Auth (login + persistencia de datos en la nube) ──
# Crea el proyecto en supabase.com → Project Settings → API.
# VITE_SUPABASE_URL = Project URL (pública, ej. https://xxxx.supabase.co)
# VITE_SUPABASE_ANON_KEY = anon public key (segura en el cliente con RLS activo)
# En Vercel: Project Settings → Environment Variables (mismas variables).
# Auth callback: <VITE_SUPABASE_URL>/auth/v1/callback (Google OAuth).
# Redirect URLs permitidas en Supabase Dashboard → Authentication → URL Configuration:
#   http://localhost:5173/auth/callback y https://TU-DOMINIO.vercel.app/auth/callback

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

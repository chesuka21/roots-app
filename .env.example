# Copy this file to .env (for local dev) and fill in your own keys.
# On Vercel, add these same variables under Project Settings → Environment Variables.
# ANTHROPIC_API_KEY ya no se usa. El backend usa Groq primero (rápido) y
# Gemini como fallback. Pon al menos GROQ_API_KEY.

GROQ_API_KEY=gsk_...
# Opcional pero recomendado como fallback:
GEMINI_API_KEY=...
# Modelos Groq (ago-2026). Los viejos llama-3.1-8b-instant y
# llama-3.3-70b-versatile fueron RETIRADOS por Groq — NO los uses.
# Recomendado (rápido y barato): openai/gpt-oss-20b.
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.6-flash

UNSPLASH_ACCESS_KEY=...
VOICERSS_API_KEY=...